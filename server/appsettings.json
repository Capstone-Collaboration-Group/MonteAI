{
    "Logging": {
        "LogLevel": {
            "Default": "Information",
            "Microsoft.AspNetCore": "Warning"
        }
    },
    "AllowedHosts": "*",

    "Auth": {
        "Issuer": "MonteAI",
        "Audience": "MonteAI.API",
        "AccessTokenMinutes": 60,
        "RefreshTokenDays": 30,
        "PendingTokenMinutes": 5
    },

    "DataProtection": {
        "KeysPath": ""
    },

    "MonteAI": {
        "Agent": {
            "EnableAgentMode": true,
            "MaxAgentIterations": 3,
            "HistoryMessageCount": 3,
            "PlanningMaxOutputTokens": 250,
            "AnswerMaxOutputTokens": 800,
            "PlanningTemperature": 0.0,
            "AnswerTemperature": 0.2,
            "MaxSources": 4,
            "MaxQueryLength": 2000,
            "MaxConcurrentAgentRuns": 30,
            "MaxGateWaitSeconds": 45
        }
    },

    "AzureAI": {
        "ProjectEndpoint": "https://YOUR-RESOURCE.services.ai.azure.com/api/projects/YOUR-PROJECT",
        "Deployments": [
            {
                "Name": "nano-planner",
                "AgentName": "monteai-agent-planner",
                "Roles": [ "planner" ],
                "MaxConcurrency": 8,
                "TimeoutSeconds": 20,
                "JsonMode": true
            },
            {
                "Name": "nano-synth",
                "AgentName": "monteai-agent-synth",
                "Roles": [ "synth" ],
                "MaxConcurrency": 12,
                "TimeoutSeconds": 30,
                "JsonMode": false
            }
        ]
    },

    "Pinecone": {
        "IndexName": "research-assistant-abstracts",
        "TopK": 5,
        "ScoreThreshold": 0.25,
        "EmbeddingBatchSize": 16,
        "MaxUpsertBatchSize": 100,
        "MaxChunksPerIngest": 64
    },

    "Serilog": {
        "Using": [ "Serilog.Sinks.Console", "Serilog.Sinks.File" ],
        "MinimumLevel": {
            "Default": "Debug",
            "Override": {
                "Microsoft": "Warning",
                "System": "Warning"
            }
        },
        "WriteTo": [
            {
                "Name": "Console",
                "Args": {
                    "outputTemplate": "[{Timestamp:HH:mm:ss} {Level:u3}] {Message:lj}{NewLine}{Exception}"
                }
            },
            {
                "Name": "File",
                "Args": {
                    "path": "logs/log-.txt",
                    "rollingInterval": "Day",
                    "formatter": "Serilog.Formatting.Json.JsonFormatter, Serilog"
                }
            }
        ],
        "Enrich": [ "FromLogContext", "WithMachineName", "WithThreadId" ]
    }

}
